# ============================================
# AI-NEWSMAKER - Environment Variables
# ============================================
# Copy this file to .env and fill in values

# ============== AI PROVIDERS ==============

# OpenRouter (recommended - access to all models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Google Gemini (alternative)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Provider to use: openrouter | gemini | openai | anthropic
DEFAULT_LLM_PROVIDER=openrouter

# ============== SOCIAL MEDIA ==============

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AABBccDDeeFFggHHiiJJkkLLmmNNooP
TELEGRAM_CHANNEL_ID=@YourChannelName
TELEGRAM_DEFAULT_CHAT_ID=@YourChannelName

# VKontakte (get token from vk.com/dev)
VK_ACCESS_TOKEN=vk1.a.your-vk-access-token
VK_GROUP_ID=-123456789

# ============== DATABASE ==============

POSTGRES_USER=newsmaker
POSTGRES_PASSWORD=newsmaker_dev_password
POSTGRES_DB=newsmaker
REDIS_PASSWORD=redis_dev_password

# ============== STORAGE ==============

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
RABBITMQ_DEFAULT_USER=newsmaker
RABBITMQ_DEFAULT_PASS=newsmaker_rabbit_pass
