{
  "name": "@ai-newsmaker/publishing-service",
  "version": "1.0.0",
  "description": "Publishing service for AI Newsmaker - handles posting to social media platforms",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "rss:build": "node zen/build-feed.js",
    "proto:generate": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/proto --grpc_out=grpc_js:./src/proto --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` ../../*.proto",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "grpc",
    "social-media",
    "publishing",
    "telegram",
    "vk",
    "instagram"
  ],
  "author": "AI Newsmaker Team",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "axios": "^1.6.5",
    "bullmq": "^5.1.5",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "instagram-private-api": "^1.45.4",
    "ioredis": "^5.3.2",
    "node-telegram-bot-api": "^0.64.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "twitter-api-v2": "^1.15.2",
    "uuid": "^9.0.1",
    "vk-io": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
