# AI-Newsmaker Environment Variables
# Скопируйте: cp env.example .env
# И заполните значения

# ============== AI PROVIDERS ==============
# OpenAI (GPT-4, DALL-E)
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Yandex (YandexGPT, Kandinsky)
YANDEX_API_KEY=...
YANDEX_FOLDER_ID=...

# Replicate (Stable Diffusion)
REPLICATE_API_TOKEN=r8_...

# ============== SOCIAL MEDIA ==============
# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHANNEL_ID=@...

# VKontakte
VK_ACCESS_TOKEN=...
VK_GROUP_ID=...


