# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should use LF
*.sh text eol=lf

# Batch scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Python files should use LF
*.py text eol=lf

# YAML files should use LF
*.yaml text eol=lf
*.yml text eol=lf

# Markdown files should use LF
*.md text eol=lf

# Proto files should use LF
*.proto text eol=lf

# Config files
*.txt text eol=lf
*.json text eol=lf

