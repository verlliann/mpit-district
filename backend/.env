# Instagram (логин/пароль для Instagram Private API)
INSTAGRAM_USERNAME=your-instagram-username
INSTAGRAM_PASSWORD=your-instagram-password

# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ===========================================
# Database (PostgreSQL)
# ===========================================

DATABASE_URL=postgresql://newsmaker:newsmaker_dev_password@localhost:5432/newsmaker
POSTGRES_USER=newsmaker
POSTGRES_PASSWORD=newsmaker_dev_password
POSTGRES_DB=newsmaker

# ===========================================
# Redis
# ===========================================

REDIS_URL=redis://:redis_dev_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# ===========================================
# MinIO (S3-совместимое хранилище)
# ===========================================

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=media
MINIO_SECURE=false

# ===========================================
# RabbitMQ
# ===========================================

RABBITMQ_URL=amqp://newsmaker:newsmaker_rabbit_pass@localhost:5672
RABBITMQ_DEFAULT_USER=newsmaker
RABBITMQ_DEFAULT_PASS=newsmaker_rabbit_pass

# ===========================================
# gRPC Services Ports
# ===========================================

STORAGE_GRPC_PORT=50055
PARSER_GRPC_PORT=50051
AI_ENGINE_GRPC_PORT=50052
MEDIA_GRPC_PORT=50053
PUBLISHING_GRPC_PORT=50054
GRAPHQL_PORT=4000

# ===========================================
# gRPC Service URLs (для Docker)
# ===========================================

STORAGE_GRPC_URL=storage-service:50055
PARSER_GRPC_URL=parser-service:50051
AI_ENGINE_GRPC_URL=ai-engine-service:50052
MEDIA_GRPC_URL=media-service:50053
PUBLISHING_GRPC_URL=publishing-service:50054

# ===========================================
# Security
# ===========================================

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Logging & Monitoring
# ===========================================

LOG_LEVEL=info
NODE_ENV=development

# ===========================================
# Rate Limiting
# ===========================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Retry Configuration
# ===========================================

MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
RETRY_BACKOFF_MULTIPLIER=2

