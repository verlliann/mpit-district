# AI Newsmaker - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# AI ENGINE SERVICE - LLM Models
# ============================================================

# OpenAI (GPT-4o, GPT-4-turbo) - REQUIRED for main functionality
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude Sonnet 4) - OPTIONAL, alternative LLM
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Yandex GPT - OPTIONAL, Russian language optimized
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-folder-id

# Default LLM provider: openai | anthropic | yandex
DEFAULT_LLM_PROVIDER=openai

# Model versions (optional, defaults shown)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
YANDEX_MODEL=yandexgpt-lite

# ============================================================
# MEDIA SERVICE - Image Generation Models
# ============================================================

# OpenAI DALL-E 3 - Uses same key as above
# (OPENAI_API_KEY is shared)

# Replicate (Stable Diffusion XL) - OPTIONAL
REPLICATE_API_TOKEN=r8_your-replicate-token

# Yandex Kandinsky - Uses same key as above
# (YANDEX_API_KEY is shared)

# ============================================================
# INFRASTRUCTURE
# ============================================================

# MinIO (defaults, change for production)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
